 "poc_source_read": {
  "commit": "d9275feeca1a799928b6eb1a866d32275c4024b5",
  "entries": [
   {
    "fact": "chaos_boss_bonus(seconds, rings): H = max(0, 9 - floor(seconds / 30)); L = (rings - 11) mod 100; steps = H * 100 + L",
    "file": "scripts/SCR_chaos_boss/SCR_chaos_boss.gml",
    "lines": "173-179, 220-228",
    "versus_rom": "ROM bucket limits are strict mm:ss BCD 0:29, 0:59, 1:29, ... 3:59, 4:59 (not floor(s/30)); the POC formula flips one second early on every boundary and has no 4:59 last bucket"
   },
   {
    "fact": "global.chaosBossClearScore = ring * 10 + steps + 500",
    "file": "scripts/SCR_chaos_boss/SCR_chaos_boss.gml (and gpz/mghz/sez boss scripts)",
    "lines": "223 / 205 / 313 / 361",
    "versus_rom": "the fixed boss bonus is zone dependent 500/1000/1500/2000/2500 (table $2D84), not a constant 500; and it is a results-tally component, not a pre-computed clear score"
   },
   {
    "fact": "chaos_act_complete: results only for act < 3; act 3 keeps the developer return (90 ticks) or zoneGoto progression + SCR_save_game",
    "file": "scripts/SCR_chaos_level/SCR_chaos_level.gml",
    "lines": "476-493",
    "versus_rom": "the ROM runs the same results/tally/title tail for act index 2 (D293 bit 4 -> $1543) with the fixed boss bonus first"
   },
   {
    "fact": "chaos_results_bonus: G1-D corrected ROM word incl. the sign child's zero -> 777 replacement",
    "file": "scripts/SCR_chaos_results/SCR_chaos_results.gml",
    "lines": "29-40",
    "versus_rom": "correct for the sign child $19; the boss object $0A has NO zero replacement (zero stays zero) and no equal-digit life"
   }
  ],
  "note": "read-only; not run; not ROM evidence"
 },
